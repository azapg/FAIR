# FAIR researcher/local profile (defaults when these are omitted)
FAIR_DEPLOYMENT_MODE=COMMUNITY
DATABASE_URL=sqlite:///fair.db
# Set this to a persistent volume mount for shared single-node deployments.
# DATABASE_URL should point to a file inside the same directory.
# FAIR_DATA_DIR=/data
FAIR_STORAGE_BACKEND=local
FAIR_AUTO_MIGRATE=1
FAIR_BASE_URL=http://localhost:3000
FAIR_API_BASE_URL=http://localhost:8000
# Use a unique value if the service is reachable by anyone else.
SECRET_KEY=replace-for-shared-environments

# FAIR institutional profile (uncomment and replace values)
# FAIR_DEPLOYMENT_MODE=ENTERPRISE
# Registration and AI policy defaults remain compatible when omitted: public
# registration is open and weighted-credit enforcement is disabled. For a
# shared deployment, these environment values lock the corresponding controls
# in the admin UI. Classify capabilities and grant entitlements before enabling
# AI controls.
# FAIR_ADMISSION_MODE=invite_only
# Approved-domain deployments should verify address ownership. Configure the
# mail provider secret in the deployment secret store, not in source control.
# FAIR_RESEND_API_KEY=replace-me
# FAIR_EMAIL_SENDER=FAIR Platform <platform@example.edu>
# FAIR_EMAIL_ENABLED=1
# FAIR_ENFORCE_EMAIL_VERIFICATION=1
# Unattended deployments may create exactly one administrator when the user
# table is empty. Establish its password through the normal reset-email flow.
# FAIR_BOOTSTRAP_ADMIN_EMAIL=admin@example.edu
# FAIR_BOOTSTRAP_ADMIN_NAME=FAIR Administrator
# FAIR_AI_CONTROLS_ENABLED=true
# DATABASE_URL=postgresql+psycopg://fair:replace-me@postgres:5432/fair
# FAIR_STORAGE_BACKEND=s3
# S3_BUCKET_NAME=fair-institution
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=https://s3.example.edu
# S3_ACCESS_KEY=replace-me
# S3_SECRET_KEY=replace-me
# SECRET_KEY=replace-with-a-long-random-secret
# FAIR_DISPATCH_SIGNING_PRIVATE_KEY=replace-with-base64url-encoded-32-byte-key
# FAIR_BASE_URL=https://fair.example.edu
# FAIR_API_BASE_URL=https://api.fair.example.edu
# FAIR_CORS_ORIGINS=https://fair.example.edu
# Set this to the trusted reverse-proxy addresses that may supply forwarded
# headers. Managed platforms with no direct application ingress may require *.
# FORWARDED_ALLOW_IPS=127.0.0.1
# FAIR_AUTO_MIGRATE=1

# A local-to-S3 migration can read both schemes while writing to S3.
# FAIR_STORAGE_BACKENDS=local,s3
# FAIR_STORAGE_BACKEND=s3
